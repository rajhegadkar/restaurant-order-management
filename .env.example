# ============================================================================
# Restaurant Online Ordering & QR Table Management - Environment Config
# ============================================================================
# NOTE: Supabase is OPTIONAL. Without these keys, the app runs 100% locally
# out-of-the-box with built-in sample data, localStorage persistence, and
# real-time multi-device Wi-Fi LAN synchronization via the built-in API.
#
# To connect a live Supabase PostgreSQL database:
# 1. Run `supabase/schema.sql` in your Supabase SQL Editor.
# 2. Create a public storage bucket named `food-images`.
# 3. Fill in your project credentials below.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
